# Discord Developer Portal -> Bot -> Token. Never commit the real value.
DISCORD_BOT_TOKEN=
# Discord Developer Portal -> General Information -> Application ID.
DISCORD_APP_ID=

# Postgres connection string used by the bot.
DATABASE_URL=postgres://merlin:changeme@postgres:5432/merlin?sslmode=disable
# Credentials for the postgres container itself (docker-compose.yml).
POSTGRES_USER=merlin
POSTGRES_PASSWORD=changeme

# Path to the bootstrap config file (see config.example.yaml — just log
# level now; guild settings are DB-backed, see below). Must be an absolute
# path matching the container-side mount target in
# docker-compose.yml/docker-compose.prod.yml (the distroless base image's
# working directory isn't "/", so a relative path is fragile).
MERLIN_CONFIG_PATH=/config.yaml

# A Discord user ID that always has admin access to /config, in every guild,
# regardless of what's configured in internal/settings (DB-backed). This is
# the one identity that guarantees you can always recover if a guild's admin
# list is ever wiped or misconfigured — set it to your own Discord user ID.
# Never DB-backed, never delegatable.
MERLIN_BOOTSTRAP_ADMIN_USER_ID=

# debug | info | warn | error. Overrides log_level in config.yaml when set,
# so verbosity can be raised during an incident by editing .env and
# restarting, without touching the mounted config file.
LOG_LEVEL=info

# Emergency stop. When set to 1/true/yes/on, every destructive Discord action
# (channel rotation, archive deletion, jail, role changes) is refused
# process-wide, in every guild, while read and inspect commands keep working.
# This is the host-level lever for when the bot is actively doing damage and
# you can't reach Discord or the database — the per-guild equivalents are
# /config pause and /config dryrun. Takes effect on restart.
MERLIN_PAUSE_ALL_WRITES=

# Optional. Adds Discord's privileged GUILD_MEMBERS gateway intent so a jailed
# member who leaves and rejoins is re-jailed the instant they return, instead
# of on the next one-minute sweep. Jail already survives a rejoin without
# this — it only narrows the window. If you set it, also tick "Server Members
# Intent" for the application in the Discord Developer Portal, or the gateway
# will refuse the connection at startup.
MERLIN_ENABLE_GUILD_MEMBERS_INTENT=
