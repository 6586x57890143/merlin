# Discord Developer Portal -> Bot -> Token. Never commit the real value.
DISCORD_BOT_TOKEN=
# Discord Developer Portal -> General Information -> Application ID.
DISCORD_APP_ID=

# Postgres connection string used by the bot.
DATABASE_URL=postgres://merlin:changeme@postgres:5432/merlin?sslmode=disable
# Credentials for the postgres container itself (docker-compose.yml).
POSTGRES_USER=merlin
POSTGRES_PASSWORD=changeme

# Path to the bootstrap config file (see config.example.yaml — just log
# level now; guild settings are DB-backed, see below). Must be an absolute
# path matching the container-side mount target in
# docker-compose.yml/docker-compose.prod.yml (the distroless base image's
# working directory isn't "/", so a relative path is fragile).
MERLIN_CONFIG_PATH=/config.yaml

# A Discord user ID that always has admin access to /config, in every guild,
# regardless of what's configured in internal/settings (DB-backed). This is
# the one identity that guarantees you can always recover if a guild's admin
# list is ever wiped or misconfigured — set it to your own Discord user ID.
# Never DB-backed, never delegatable.
MERLIN_BOOTSTRAP_ADMIN_USER_ID=

LOG_LEVEL=info
