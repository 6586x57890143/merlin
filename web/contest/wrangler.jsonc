{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "contest",
  "main": "worker.js",
  "compatibility_date": "2025-08-01",

  // The Worker answers on melting.lol, which is a Cloudflare-managed zone on
  // this same account, so `custom_domain` is all it takes: wrangler creates
  // the DNS record and provisions the certificate on deploy. There is no A or
  // CNAME to write by hand, and writing one anyway is how you get a record
  // fighting the route.
  //
  // Two things have to be true before a deploy that moves this, and neither
  // is visible from here. Discord's OAuth redirect allowlist must already
  // carry https://contest.melting.lol/oauth/callback, or voting 400s on the
  // new host the moment the domain resolves. And the workers.dev route stays
  // enabled on purpose: every contest announcement already sitting in a
  // Discord channel carries the old origin as literal text, and a results
  // gallery is meant to stay readable for artRefreshWindow (30 days) past
  // close.
  "routes": [
    { "pattern": "contest.melting.lol", "custom_domain": true }
  ],

  // Static assets are served from here, but not automatically: the Worker
  // fetches index.html itself so it can attach the noindex headers. A
  // gallery of members' work on a server whose threat model is mass
  // reporting should be reachable by anyone with the link and by no crawler.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",

    // ...but "not automatically" was never true of the root. Static assets
    // are matched *before* the Worker runs, and public/index.html matches
    // "/", so "/" never reached fetch(): it answered 200 with the gallery
    // shell instead of the Worker's "you want the link from your server"
    // 404, with {{COMMIT}} left as a literal and no x-robots-tag on the
    // response. The meta robots tag inside index.html still covered the
    // crawler half, so this was a layer thin rather than open, but the root
    // was answering the wrong thing and nothing said so.
    //
    // Only "/" is listed. Everything under /stickers/ keeps coming straight
    // off the asset layer without waking the Worker, which has no route for
    // it and would 404 the lot.
    "run_worker_first": ["/"]
  },

  // The database keeps the old name deliberately. Only the Worker was
  // renamed; renaming a D1 database to match is a migration, not a tidy-up.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "merlin-contests",
      "database_id": "ccab8c80-44d1-4be2-8d36-393c09ea7928"
    }
  ],

  "observability": { "enabled": true }

  // Secrets, set with `wrangler secret put` and never written here:
  //   BOT_TOKEN  must equal merlin's MERLIN_CONTEST_WORKER_TOKEN
  //   LINK_KEY   must equal merlin's MERLIN_CONTEST_LINK_KEY
}
